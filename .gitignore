# Python
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
.venv/
venv/
env/
*.egg-info/
.eggs/
dist/
*.egg
.pytest_cache/
.pytest_tmp/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.hypothesis/

# Secrets / local env (never commit API keys)
.env
.env.*
!.env.example
!**/.env.example
backend/.env
frontend/.env

# Node / frontend build
node_modules/
**/node_modules/
dist/
.vite/
build/
**/build/
coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Data — raw datasets stay local
data/raw/*
!data/raw/.gitkeep
!data/raw/README_PLACE_DATASETS_HERE.txt

# Data — embeddings / FAISS (regenerated by pipeline)
data/embeddings/*
!data/embeddings/.gitkeep

# Data — processed artefacts (parquet, sqlite, reports, state, tombstones)
data/processed/*
!data/processed/.gitkeep
!data/processed/eda_plots/
!data/processed/explain/
!data/processed/models/
data/processed/eda_plots/*
!data/processed/eda_plots/.gitkeep
data/processed/explain/*
!data/processed/explain/.gitkeep
data/processed/models/*
!data/processed/models/.gitkeep

# Data — train/val/test splits + balanced embeddings
data/splits/train/*
!data/splits/train/.gitkeep
data/splits/val/*
!data/splits/val/.gitkeep
data/splits/test/*
!data/splits/test/.gitkeep

# Data — gold evaluation subset (regenerated by research.close_proposal_gaps)
data/gold/*
!data/gold/.gitkeep

# Binary / ML artefacts anywhere under the repo
*.parquet
*.npy
*.bin
*.joblib
*.db
*.sqlite
*.sqlite3

# Logs
logs/
*.log
!logs/.gitkeep

# Research — sensitive practitioner / coding data (keep reports)
research/interviews/*
!research/interviews/.gitkeep
research/coding/*
!research/coding/.gitkeep
research/practitioner_eval/participants.json
research/practitioner_eval/responses.json
research/practitioner_eval/*.json.bak
research/ethics/consent_log.json
research/ethics/consent_log*.json

# Security auditor generated dumps (appendix copies live under research/reports/)
research/security_eval/reports/*
!research/security_eval/reports/.gitkeep

# Notebooks — keep jupytext .py sources; ignore converted notebooks / checkpoints
.ipynb_checkpoints/
notebooks/.ipynb_checkpoints/
notebooks/*.ipynb

# IDE / editor / local tooling
.idea/
.vscode/
*.swp
*.swo
.cursor/

# OS junk
.DS_Store
Thumbs.db
Desktop.ini
