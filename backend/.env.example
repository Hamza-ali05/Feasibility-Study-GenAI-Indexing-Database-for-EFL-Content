# EFL IndexDB backend — example environment (copy to project-root .env or backend/.env)
# NEVER commit a real .env file.

# --- Embeddings / index paths (optional overrides; defaults are under data/) ---
SBERT_MODEL=sentence-transformers/all-MiniLM-L6-v2
# FAISS_INDEX_PATH=data/embeddings/faiss_index.bin
# METADATA_DB_PATH=data/processed/metadata.db
# ANALYTICS_DB_PATH=data/processed/analytics.db
# DATA_RAW_DIR=data/raw

# --- Logging ---
LOG_LEVEL=INFO
# Set DEBUG=true only for local development (detailed 500 responses).
DEBUG=false

# --- Anthropic (RAG + Analyzer LLM classify) ---
ANTHROPIC_API_KEY=
RAG_MODEL=claude-sonnet-4-6

# --- Admin Panel auth (single admin) ---
ADMIN_USERNAME=admin
# Generate with:
#   python -m backend.auth.generate_password_hash "your-chosen-password"
ADMIN_PASSWORD_HASH=

# Generate your own random secret (32+ chars). Do NOT reuse this placeholder.
# PowerShell example:
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | ForEach-Object {[char]$_})
JWT_SECRET=

# --- Frontend CORS (CRA default) ---
CORS_ORIGIN=http://localhost:3000
